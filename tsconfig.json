{
  // Single tsconfig for the standalone React SPA. Replaces the old three-file
  // composite (tsconfig.json solution + tsconfig.web.json + tsconfig.node.json)
  // now that there is no Electron main/preload build.
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Vite) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases (mirror vite.config.ts) */
    "baseUrl": ".",
    "paths": {
      "@supabase/supabase-js": ["node_modules/@supabase/supabase-js"],
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@tubeghost/ui": ["../tubeghost-ui/src/index.ts"],
      "@/*": ["src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    "../tubeghost-ui/src/**/*.ts",
    "../tubeghost-ui/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "out", "**/__tests__/**", "**/*.test.ts"]
}
