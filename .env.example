# ─────────────────────────────────────────────────────────────────────────
# TubeGhost web app — environment variables
#
# Copy to `.env` for local dev and fill in real values. In production these are
# set in the Vercel project (Settings → Environment Variables), NOT from this
# file. Anything WITHOUT a VITE_ prefix is server-only and never reaches the
# browser bundle; anything WITH VITE_ is public (bundled into the SPA).
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (browser) ──────────────────────────────────────────────
# The SPA authenticates + queries directly against Supabase (RLS-protected).
#
# This is the CONSOLIDATED project shared with TubeProxies
# (qkntgnepntnbnqipuavv). TubeGhost's tables live in the `ghost` schema —
# the browser client sets `db: { schema: 'ghost' }` — and TubeProxies owns
# `public`, which TubeGhost reads via getPublicSchema() only.
#
# `ghost` MUST be listed under Supabase → Settings → API → Exposed schemas,
# or PostgREST refuses to serve it at all.
VITE_SUPABASE_URL=https://qkntgnepntnbnqipuavv.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY

# ── Supabase (server) ───────────────────────────────────────────────
# Same project. SUPABASE_URL + SERVICE_ROLE are already used by the existing
# Google-OAuth handoff (already set in Vercel prod). SUPABASE_ANON_KEY is the
# SAME value as VITE_SUPABASE_ANON_KEY above — the MCP relay needs it without
# the VITE_ prefix to verify a user's login session server-side.
#
# The relay's PostgREST calls (api/_lib/db.ts, api/_lib/handoff.ts) send
# Accept-Profile/Content-Profile: ghost, so they hit the same schema the SPA
# does — service-role still bypasses RLS, so every query filters by user_id.
SUPABASE_URL=https://qkntgnepntnbnqipuavv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY

# ── Canonical app origin (MCP relay) ────────────────────────────────
# NO trailing slash. EVERY absolute URL (OAuth issuer, token audience, metadata,
# connector URL) derives from this — never hardcode the host. VITE_ copy is the
# public one the dashboard reads to show the connector URL; keep them identical.
PUBLIC_BASE_URL=https://app.tubeghost.com
VITE_PUBLIC_BASE_URL=https://app.tubeghost.com
# For local dev, set BOTH to your local/tunnel origin instead, e.g.:
#   PUBLIC_BASE_URL=http://localhost:3000
#   VITE_PUBLIC_BASE_URL=http://localhost:3000

# ── Upstash Redis (MCP command bus + OAuth state) ───────────────────
# Provision via Vercel → Storage → "Upstash for Redis"; Vercel then injects
# these two automatically in prod. For local dev, copy them from the Upstash
# database's "REST API" section.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR-UPSTASH-REST-TOKEN

# ── MCP access-token signing secret ─────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates outstanding Claude access tokens (1h TTL) — harmless.
OAUTH_JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# ── Existing Google-OAuth handoff (unrelated to MCP; already in Vercel) ──
# Listed for completeness — the desktop Google sign-in bridge uses these.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# OAUTH_REDIRECT_URI=https://app.tubeghost.com/api/oauth/google/callback
