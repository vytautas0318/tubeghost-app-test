.env
.env.local
.env.*.local

# Per-machine credentials/scratch files — never commit.
# r2.md was used during R2 setup and has real Access Key + Secret. Keep
# locally for reference but never push.
r2.md
*.secrets.md
*.credentials

# Supabase CLI cache (per-machine state, not source).
supabase/.temp/

.tmp/

