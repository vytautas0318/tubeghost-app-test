{
  // Serverless functions build for Node, not the browser — a separate config
  // from the root SPA tsconfig (whose `include` deliberately covers only
  // src/renderer + src/shared, and whose lib includes DOM).
  //
  // Typechecked by `npm run typecheck:api`, which the main `typecheck` script
  // chains, so a broken function fails the build like any other type error.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
