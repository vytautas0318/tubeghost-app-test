  "author": "TubeProxies",
  "homepage": "https://tubeproxies.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p api/tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p api/tsconfig.json",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "eslint --cache ."
  },
  "dependencies": {
