    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.14.0",
    "otpauth": "^9.5.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.75.0",
